# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Supabase > Project Settings > Database > Connection string
# Runtime: transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations (Prisma CLI): session pooler or direct connection (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key — storage uploads + seed only. NEVER expose to the browser.
SUPABASE_SECRET_KEY=

STORAGE_BUCKET=images

# Google reCAPTCHA v2 ("I'm not a robot" checkbox)
# Create keys at https://www.google.com/recaptcha/admin and add localhost/your domain.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Random string, at least 32 chars (e.g. `openssl rand -hex 32`). Signs app cookies
# and peppers OTP hashes.
CSRF_SECRET=

# Local auth policy. Values below are the defaults; override only if needed.
SESSION_TTL_DAYS=7
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# SMTP for OTP activation and password-reset mail.
# Recommended for local demos: Mailtrap, Ethereal, or a Gmail app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Team13 Restaurant <no-reply@team13.local>

# Used by `npm run db:seed` to create/update the first ADMIN with a local password
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
