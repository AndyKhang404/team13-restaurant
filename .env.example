# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Supabase > Project Settings > Database > Connection string
# Runtime: transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations (Prisma CLI): session pooler or direct connection (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable / anon key — used by the SSR auth client
SUPABASE_ANON_KEY=
# Secret / service_role key — storage uploads + seed only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_BUCKET=images

# Random string, at least 32 chars (e.g. `openssl rand -hex 32`). Also signs app cookies.
CSRF_SECRET=

# Used by `npm run db:seed` to create the first ADMIN
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
