generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// App-side user account. New registrations start as PENDING until the email
/// OTP is verified; roles default to VIEWER (Block 8 only requires login for
/// content CRUD, detailed RBAC is a Block 9 concern).
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Profile {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String
  emailNormalized   String                   @unique @map("email_normalized")
  passwordHash      String?                  @map("password_hash")
  displayName       String?                  @map("display_name")
  role              Role                     @default(VIEWER)
  status            AccountStatus            @default(PENDING)
  emailVerifiedAt   DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?                @map("password_changed_at") @db.Timestamptz(6)
  search_vector     Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(email, ''::text))), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(display_name, ''::text))), 'B'::\"char\"))"))
  passwordResets    PasswordReset[]
  activationChallenge ActivationChallenge?
  sessions          Session[]

  @@index([email])
  @@index([role])
  @@index([search_vector], map: "idx_profiles_search_vector", type: Gin)
  @@map("profiles")
}

/// One-time password-reset requests. Only the SHA-256 digest of the token that
/// travels in the email is stored here; `used_at` is set when POST /reset wins.
model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([email])
  @@map("password_resets")
}

/// Pending email-activation challenge. One row per account; resending rotates
/// the OTP hash without resetting the failure count.
model ActivationChallenge {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  purpose         String    @default("activation")
  otpHash         String    @map("otp_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts        Int       @default(0)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  lastSentAt      DateTime  @map("last_sent_at") @db.Timestamptz(6)
  sendCount       Int       @default(1) @map("send_count")
  sendWindowStart DateTime  @default(now()) @map("send_window_start") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user            Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("activation_challenges")
}

/// Opaque server-side login session. The cookie carries a random `sid`; this
/// table stores only its SHA-256 digest, so copying the cookie is not enough to
/// reconstruct the stored value.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sidHash    String    @unique @map("sid_hash")
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Đầu bếp — one chef cooks many dishes.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Chef {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  avatarUrl       String?                  @map("avatar_url")
  specialty       String?
  bio             String?
  experienceYears Int?                     @default(0) @map("experience_years")
  phone           String?
  isActive        Boolean?                 @default(true) @map("is_active")
  createdAt       DateTime?                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(6)
  search_vector   Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(name, ''::text))), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(specialty, ''::text))), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(bio, ''::text))), 'C'::\"char\"))"))
  dishes          Dish[]

  @@index([search_vector], map: "idx_chefs_search_vector", type: Gin)
  @@map("chefs")
}

/// Nguyên liệu.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Ingredient {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String                   @unique
  unit          String                   @default("g")
  stockQuantity Decimal?                 @default(0) @map("stock_quantity") @db.Decimal(10, 2)
  pricePerUnit  Decimal?                 @default(0) @map("price_per_unit") @db.Decimal(12, 2)
  imageUrl      String?                  @map("image_url")
  isAvailable   Boolean?                 @default(true) @map("is_available")
  createdAt     DateTime?                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?                @map("deleted_at") @db.Timestamptz(6)
  search_vector Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(name, ''::text))), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(unit, ''::text))), 'D'::\"char\"))"))
  dishes        DishIngredient[]

  @@index([search_vector], map: "idx_ingredients_search_vector", type: Gin)
  @@map("ingredients")
}

/// Món ăn — each dish optionally belongs to one chef.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Dish {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String                   @unique
  description     String?
  imageUrl        String?                  @map("image_url")
  price           Decimal                  @db.Decimal(12, 2)
  isAvailable     Boolean?                 @default(true) @map("is_available")
  isFeatured      Boolean?                 @default(false) @map("is_featured")
  prepTimeMinutes Int?                     @map("prep_time_minutes")
  chefId          String?                  @map("chef_id") @db.Uuid
  createdAt       DateTime?                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(6)
  category        DishCategory             @default(main)
  search_vector   Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(name, ''::text))), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(description, ''::text))), 'B'::\"char\"))"))
  ingredients     DishIngredient[]
  chef            Chef?                    @relation(fields: [chefId], references: [id], onUpdate: NoAction)

  @@index([chefId], map: "idx_dishes_chef")
  @@index([isAvailable], map: "idx_dishes_available")
  @@index([search_vector], map: "idx_dishes_search_vector", type: Gin)
  @@map("dishes")
}

/// Định lượng — N-N between dishes and ingredients.
model DishIngredient {
  dishId       String     @map("dish_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  quantity     Decimal    @db.Decimal(10, 2)
  unit         String?    @default("g")
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([dishId, ingredientId])
  @@index([ingredientId], map: "idx_dish_ingredients_ingredient")
  @@map("dish_ingredients")
}

enum Role {
  VIEWER
  STAFF
  ADMIN

  @@map("role")
}

enum AccountStatus {
  PENDING
  ACTIVE

  @@map("account_status")
}

enum DishCategory {
  appetizer
  main
  dessert
  drink
  combo

  @@map("dish_category")
}
