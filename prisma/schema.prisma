// Team13 Restaurant — Prisma schema (source of truth for the database).
// Translated from supabase/schema.sql, plus: profiles/roles, soft delete, category enum.
// CHECK constraints and RLS policies live in hand-written SQL inside the migrations.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER

  @@map("role")
}

enum DishCategory {
  appetizer
  main
  dessert
  drink
  combo

  @@map("dish_category")
}

/// App-side user profile. `id` equals `auth.users.id` (Supabase Auth).
/// Created lazily on first login; role defaults to CUSTOMER.
model Profile {
  id           String                   @id @db.Uuid
  email        String
  displayName  String?                  @map("display_name")
  role         Role                     @default(CUSTOMER)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([email])
  @@index([role])
  @@index([searchVector], map: "idx_profiles_search_vector", type: Gin)
  @@map("profiles")
}

/// Đầu bếp — one chef cooks many dishes.
model Chef {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  avatarUrl       String?                  @map("avatar_url")
  specialty       String? // e.g. Món Âu, Sushi, Món Việt
  bio             String?
  experienceYears Int                      @default(0) @map("experience_years")
  phone           String?
  isActive        Boolean                  @default(true) @map("is_active")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(6)
  searchVector    Unsupported("tsvector")? @map("search_vector")

  dishes Dish[]

  @@index([searchVector], map: "idx_chefs_search_vector", type: Gin)
  @@map("chefs")
}

/// Nguyên liệu.
model Ingredient {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String                   @unique // e.g. Thịt bò, Cà chua
  unit          String                   @default("g") // g, kg, ml, liter, cái, gói
  stockQuantity Decimal                  @default(0) @map("stock_quantity") @db.Decimal(10, 2)
  pricePerUnit  Decimal                  @default(0) @map("price_per_unit") @db.Decimal(12, 2)
  imageUrl      String?                  @map("image_url")
  isAvailable   Boolean                  @default(true) @map("is_available")
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?                @map("deleted_at") @db.Timestamptz(6)
  searchVector  Unsupported("tsvector")? @map("search_vector")

  dishes DishIngredient[]

  @@index([searchVector], map: "idx_ingredients_search_vector", type: Gin)
  @@map("ingredients")
}

/// Món ăn — each dish optionally belongs to one chef.
model Dish {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String // e.g. Phở Bò
  slug            String                   @unique // e.g. pho-bo (public URL)
  description     String?
  imageUrl        String?                  @map("image_url")
  price           Decimal                  @db.Decimal(12, 2)
  category        DishCategory             @default(main)
  isAvailable     Boolean                  @default(true) @map("is_available")
  isFeatured      Boolean                  @default(false) @map("is_featured") // shown on home page
  prepTimeMinutes Int?                     @map("prep_time_minutes")
  chefId          String?                  @map("chef_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(6)
  searchVector    Unsupported("tsvector")? @map("search_vector")

  chef        Chef?            @relation(fields: [chefId], references: [id], onDelete: SetNull)
  ingredients DishIngredient[]

  @@index([chefId], map: "idx_dishes_chef")
  @@index([category], map: "idx_dishes_category")
  @@index([isAvailable], map: "idx_dishes_available")
  @@index([searchVector], map: "idx_dishes_search_vector", type: Gin)
  @@map("dishes")
}

/// Định lượng — N-N between dishes and ingredients.
model DishIngredient {
  dishId       String  @map("dish_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(10, 2)
  unit         String? @default("g")

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([dishId, ingredientId])
  @@index([ingredientId], map: "idx_dish_ingredients_ingredient")
  @@map("dish_ingredients")
}
