<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{#if title}}{{title}} — Admin | Team13{{else}}Admin Portal — Team13{{/if}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
<input type="checkbox" id="theme-toggle" class="theme-toggle" aria-label="Bật/tắt chế độ tối" />
<div class="shell">

  {{> admin-nav}}

  <div class="main">
    <div class="topbar">
      <div>
        <div class="crumb">Quản trị / <b>{{title}}</b></div>
        <h1>{{title}}</h1>
      </div>
      <div class="top-right">
        <label for="theme-toggle" class="theme-switch" title="Sáng / Tối"></label>
        <span class="check">{{#if user.displayName}}{{user.displayName}}{{else}}{{user.email}}{{/if}}</span>
      </div>
    </div>

    <main class="content">
      {{> flash}}
      {{{body}}}
    </main>
  </div>
</div>
<script>
(function () {
  var input = document.getElementById('theme-toggle');
  if (localStorage.getItem('theme') === 'dark') { input.checked = true; }
  input.addEventListener('change', function () {
    var dark = input.checked;
    input.checked = !dark;
    var apply = function () {
      input.checked = dark;
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    };
    if (document.startViewTransition) {
      document.startViewTransition(apply);
    } else {
      apply();
    }
  });

  var navToggle = document.getElementById('admin-nav-toggle');
  if (navToggle) {
    document.addEventListener('click', function (e) {
      var sidebar = document.querySelector('.sidebar');
      if (navToggle.checked && sidebar && !sidebar.contains(e.target)) {
        navToggle.checked = false;
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && navToggle.checked) {
        navToggle.checked = false;
      }
    });
  }
})();
</script>
</body>
</html>
