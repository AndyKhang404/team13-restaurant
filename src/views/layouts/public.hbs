<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{#if title}}{{title}} — Team13 Restaurant{{else}}Team13 Restaurant — Nhà hàng Việt{{/if}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<input type="checkbox" id="theme-toggle" class="theme-toggle" aria-label="Bật/tắt chế độ tối" />
<div class="page">

{{> navbar}}

<main class="wrap">
  {{> flash}}
  {{{body}}}
</main>

{{> footer}}

</div>
<script>
(function () {
  var input = document.getElementById('theme-toggle');
  if (localStorage.getItem('theme') === 'dark') { input.checked = true; }
  input.addEventListener('change', function () {
    var dark = input.checked;
    input.checked = !dark;
    var apply = function () {
      input.checked = dark;
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    };
    if (document.startViewTransition) {
      document.startViewTransition(apply);
    } else {
      apply();
    }
  });
})();
</script>
</body>
</html>
