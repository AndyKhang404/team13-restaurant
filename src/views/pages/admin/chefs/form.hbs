<section class="panel form-card">
  <div class="panel-head">
    <h2>{{#if isNew}}Thêm đầu bếp mới{{else}}Sửa hồ sơ: {{chef.name}}{{/if}}</h2>
    <div class="panel-tools">
      <a class="link-quiet" href="/admin/chefs">← Danh sách đầu bếp</a>
    </div>
  </div>

  <form action="{{#if isNew}}/admin/chefs{{else}}/admin/chefs/{{chef.id}}{{/if}}" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />

    <div class="form-grid">
      <div class="field full">
        <p class="form-note">Hồ sơ hiển thị công khai ở trang chi tiết món ăn.</p>
      </div>

      <div class="field">
        <label for="name">Họ và tên <span class="req">*</span></label>
        <input type="text" id="name" name="name" value="{{values.name}}" required maxlength="120" placeholder="VD: Nguyễn Văn An" />
        {{#if errors.name}}<p class="err">{{errors.name}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="specialty">Chuyên môn</label>
        <input type="text" id="specialty" name="specialty" value="{{values.specialty}}" maxlength="120" placeholder="VD: Món Việt, Món Âu, Sushi" />
        {{#if errors.specialty}}<p class="err">{{errors.specialty}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="experienceYears">Số năm kinh nghiệm</label>
        <input type="number" id="experienceYears" name="experienceYears" min="0" max="100" step="1" value="{{values.experienceYears}}" placeholder="5" />
        {{#if errors.experienceYears}}<p class="err">{{errors.experienceYears}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="phone">Số điện thoại</label>
        <input type="tel" id="phone" name="phone" value="{{values.phone}}" maxlength="30" placeholder="+84 901 234 567" />
        {{#if errors.phone}}<p class="err">{{errors.phone}}</p>{{/if}}
      </div>

      <div class="field full">
        <label for="bio">Tiểu sử</label>
        <textarea id="bio" name="bio" rows="3" maxlength="1000" placeholder="Công việc và thành tựu ẩm thực ngắn gọn...">{{values.bio}}</textarea>
        {{#if errors.bio}}<p class="err">{{errors.bio}}</p>{{/if}}
      </div>

      <div class="field full">
        <label for="avatar">Ảnh chân dung</label>
        {{#if values.avatarUrl}}
          <div class="form-photo">
            {{> avatar url=values.avatarUrl name="Ảnh hiện tại" size=96 }}
            <div class="photo-controls">
              <input type="checkbox" id="removeImage" name="removeImage" value="on" class="remove-photo-checkbox" hidden />
              <button type="button" class="btn btn-sm btn-danger remove-photo-btn" aria-controls="removeImage" aria-pressed="false">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                <span class="remove-photo-btn-text">Gỡ ảnh hiện tại</span>
              </button>
              <span class="photo-remove-note" aria-live="polite">Đã chọn gỡ ảnh (sẽ xóa khi lưu)</span>
            </div>
          </div>
        {{/if}}
        <input type="file" id="avatar" name="avatar" accept="image/jpeg,image/png,image/webp" />
        {{#if errors.avatar}}<p class="err">{{errors.avatar}}</p>{{/if}}
        <p class="hint">JPG, PNG hoặc WebP · tối đa 2 MB.</p>
      </div>

      <div class="field full">
        <div class="check-row">
          <label class="check"><input type="checkbox" name="isActive" value="on" {{#if values.isActive}}checked{{/if}} /> Đang hoạt động (hiển thị công khai)</label>
        </div>
      </div>
    </div>

    <div class="form-foot">
      <span class="left">Trường có dấu * là bắt buộc</span>
      <a class="btn btn-quiet" href="/admin/chefs">Hủy</a>
      <button class="btn btn-primary" type="submit">{{#if isNew}}Tạo đầu bếp{{else}}Lưu thay đổi{{/if}}</button>
    </div>
  </form>
</section>
