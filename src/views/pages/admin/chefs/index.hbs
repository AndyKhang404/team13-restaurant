<section class="panel">
  <div class="panel-head">
    <h2>Danh sách đầu bếp</h2>
    <span class="count">{{chefs.length}} bản ghi</span>
    <div class="panel-tools">
      <form class="search" action="/admin/chefs" method="get">
        <input type="search" name="q" value="{{q}}" placeholder="Tìm theo tên hoặc chuyên môn" />
        <button type="submit">Tìm</button>
      </form>
      <form action="/admin/chefs" method="get" style="display:flex;gap:10px;align-items:center">
        {{#if q}}<input type="hidden" name="q" value="{{q}}" />{{/if}}
        <label class="check"><input type="checkbox" name="deleted" value="1" {{#if showDeleted}}checked{{/if}} /> Đã xóa</label>
        <button type="submit" class="btn btn-quiet btn-sm">Lọc</button>
        {{#if (or q showDeleted)}}
          <a class="link-quiet" href="/admin/chefs">Xóa lọc</a>
        {{/if}}
      </form>
      <a class="btn btn-primary" href="/admin/chefs/new">Thêm đầu bếp</a>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="width:70px">Hình</th>
          <th>Họ và tên</th>
          <th>Chuyên môn</th>
          <th style="width:110px">Kinh nghiệm</th>
          <th>Số điện thoại</th>
          <th>Trạng thái</th>
          <th style="text-align:right">Thao tác</th>
        </tr>
      </thead>
      <tbody class="fade-late">
        {{#if chefs.length}}
          {{#each chefs}}
            <tr>
              <td>
                {{> avatar url=avatarUrl name=name size=50 cls="thumb thumb-round"}}
              </td>
              <td>
                <div class="cell-item">
                  <div>
                    <b>{{name}}</b>
                    {{#if bio}}<small>{{bio}}</small>{{/if}}
                  </div>
                </div>
              </td>
              <td><span class="badge">{{#if specialty}}{{specialty}}{{else}}—{{/if}}</span></td>
              <td class="num">{{experienceYears}} năm</td>
              <td class="mono">{{#if phone}}{{phone}}{{else}}—{{/if}}</td>
              <td>
                {{#if deletedAt}}
                  <span class="badge danger">Đã xóa</span>
                {{else if isActive}}
                  <span class="badge ok">Đang làm</span>
                {{else}}
                  <span class="badge warn">Nghỉ</span>
                {{/if}}
              </td>
              <td>
                <div class="row-actions">
                  <a class="btn btn-sm btn-quiet" href="/admin/chefs/{{id}}/edit">Sửa</a>
                  {{#if deletedAt}}
                    <form class="inline-form" action="/admin/chefs/{{id}}/restore" method="POST" onsubmit="return confirm('Khôi phục đầu bếp này?')">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                      <button type="submit" class="btn btn-sm btn-quiet">Khôi phục</button>
                    </form>
                  {{else}}
                    <form class="inline-form" action="/admin/chefs/{{id}}/delete" method="POST" onsubmit="return confirm('Chuyển đầu bếp này vào danh sách đã xóa?')">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                      <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        {{/if}}
      </tbody>
    </table>

    {{#unless chefs.length}}
      <div class="empty">
        <b>Không có đầu bếp nào</b>
        Thử đổi từ khóa bộ lọc, hoặc thêm đầu bếp mới.
      </div>
    {{/unless}}

    <div class="skeleton-overlay" aria-hidden="true">
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
    </div>
  </div>

  {{> pagination}}
</section>
