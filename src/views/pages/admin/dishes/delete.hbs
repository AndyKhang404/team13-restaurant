<section class="panel form-card">
  <div class="panel-head">
    <h2>Xác nhận xóa món ăn</h2>
    <div class="panel-tools">
      <a class="link-quiet" href="/admin/dishes">← Danh sách món</a>
    </div>
  </div>

  <form action="/admin/dishes/{{dish.id}}" method="POST">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <input type="hidden" name="_method" value="DELETE" />

    <div class="form-grid">
      <div class="field full">
        <p class="form-note">
          Bạn có chắc muốn xóa <b>{{dish.name}}</b>?
          Món sẽ được chuyển vào danh sách đã xóa và có thể khôi phục sau.
        </p>
      </div>
    </div>

    <div class="form-foot">
      <a class="btn btn-quiet" href="/admin/dishes">Hủy</a>
      <button class="btn btn-danger" type="submit">Xác nhận xóa</button>
    </div>
  </form>
</section>
