<section class="panel form-card">
  <div class="panel-head">
    <h2>{{#if isNew}}Thêm món ăn mới{{else}}Sửa món: {{dish.name}}{{/if}}</h2>
    <div class="panel-tools">
      <a class="link-quiet" href="/admin/dishes">← Danh sách món</a>
    </div>
  </div>

  <form action="{{#if isNew}}/admin/dishes{{else}}/admin/dishes/{{dish.id}}{{/if}}" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />

    <div class="form-grid">
      <div class="field full">
        <p class="form-note">Điền thông tin món ăn, chọn danh mục và ghép nguyên liệu theo công thức.</p>
      </div>

      <div class="field">
        <label for="name">Tên món <span class="req">*</span></label>
        <input type="text" id="name" name="name" value="{{values.name}}" required maxlength="120" placeholder="VD: Phở bò tái lăn" />
        {{#if errors.name}}<p class="err">{{errors.name}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="slug">URL slug</label>
        <input type="text" id="slug" name="slug" value="{{values.slug}}" maxlength="120" placeholder="pho-bo-tai-lan" />
        {{#if errors.slug}}<p class="err">{{errors.slug}}</p>{{/if}}
        <p class="hint">Để trống sẽ tự sinh từ tên món.</p>
      </div>

      <div class="field full">
        <label for="description">Mô tả</label>
        <textarea id="description" name="description" rows="3" maxlength="2000" placeholder="Mô tả ngắn về món ăn, nguồn gốc hoặc hương vị...">{{values.description}}</textarea>
        {{#if errors.description}}<p class="err">{{errors.description}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="price">Giá (VNĐ) <span class="req">*</span></label>
        <input type="number" id="price" name="price" step="any" min="0" value="{{values.price}}" required placeholder="55000" />
        {{#if errors.price}}<p class="err">{{errors.price}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="category">Danh mục <span class="req">*</span></label>
        <select id="category" name="category" required>
          {{#each categories}}
            <option value="{{key}}" {{#if (eq ../values.category key)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        {{#if errors.category}}<p class="err">{{errors.category}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="prepTimeMinutes">Thời gian chuẩn bị (phút)</label>
        <input type="number" id="prepTimeMinutes" name="prepTimeMinutes" min="1" value="{{values.prepTimeMinutes}}" placeholder="15" />
        {{#if errors.prepTimeMinutes}}<p class="err">{{errors.prepTimeMinutes}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="chefId">Đầu bếp phụ trách</label>
        <select id="chefId" name="chefId">
          <option value="">Chưa phân công</option>
          {{#each chefs}}
            <option value="{{id}}" {{#if (eq ../values.chefId id)}}selected{{/if}}>
              {{name}}{{#if specialty}} · {{specialty}}{{/if}}{{#if isDeleted}} [đã xóa]{{/if}}
            </option>
          {{/each}}
        </select>
        {{#if errors.chefId}}<p class="err">{{errors.chefId}}</p>{{/if}}
      </div>

      <div class="field full">
        <label for="image">Ảnh món ăn</label>
        {{#if values.imageUrl}}
          <div class="form-photo">
            <img class="img-preview" src="{{values.imageUrl}}" alt="Ảnh hiện tại" />
            <div class="photo-controls">
              <input type="checkbox" id="removeImage" name="removeImage" value="on" class="remove-photo-checkbox" hidden />
              <button type="button" class="btn btn-sm btn-danger remove-photo-btn" aria-controls="removeImage" aria-pressed="false">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                <span class="remove-photo-btn-text">Gỡ ảnh hiện tại</span>
              </button>
              <span class="photo-remove-note" aria-live="polite">Đã chọn gỡ ảnh (sẽ xóa khi lưu)</span>
            </div>
          </div>
        {{/if}}
        <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" />
        {{#if errors.image}}<p class="err">{{errors.image}}</p>{{/if}}
        <p class="hint">JPG, PNG hoặc WebP · tối đa 2 MB.</p>
      </div>

      <div class="field full">
        <div class="check-row">
          <label class="check"><input type="checkbox" name="isAvailable" value="on" {{#if values.isAvailable}}checked{{/if}} /> Còn bán</label>
          <label class="check"><input type="checkbox" name="isFeatured" value="on" {{#if values.isFeatured}}checked{{/if}} /> Nổi bật ở trang chủ</label>
        </div>
      </div>

      <div class="field full">
        <div class="ing-head">
          <div>
            <label>Nguyên liệu &amp; định lượng</label>
            <p class="hint">Nguyên liệu theo công thức của món.</p>
          </div>
          <button type="button" class="btn btn-quiet btn-sm" id="add-ingredient-btn">+ Thêm dòng</button>
        </div>
        {{#if errors.ingredients}}<p class="err">{{errors.ingredients}}</p>{{/if}}
        <div id="ingredient-rows-container" class="ing-rows">
          {{#each dishIngredients}}
            <div class="ing-row">
              <select name="ingredient_id" class="ing-sel" required>
                <option value="">Chọn nguyên liệu</option>
                {{#each ../ingredients}}
                  <option value="{{id}}" data-unit="{{unit}}" {{#if (eq ../ingredientId id)}}selected{{/if}}>{{name}} ({{unit}}){{#if isDeleted}} [đã xóa]{{/if}}</option>
                {{/each}}
              </select>
              <input type="number" step="any" min="0.01" name="quantity" value="{{quantity}}" placeholder="SL" class="ing-qty" required />
              <input type="text" name="unit" value="{{unit}}" maxlength="30" placeholder="ĐVT" class="ing-unit" />
              <button type="button" class="remove-row-btn" title="Xóa dòng">✕</button>
            </div>
          {{/each}}
        </div>
      </div>
    </div>

    <div class="form-foot">
      <span class="left">Trường có dấu * là bắt buộc</span>
      <a class="btn btn-quiet" href="/admin/dishes">Hủy</a>
      <button class="btn btn-primary" type="submit">{{#if isNew}}Tạo món{{else}}Lưu thay đổi{{/if}}</button>
    </div>
  </form>
</section>

<script>
  const container = document.getElementById('ingredient-rows-container');
  const addBtn = document.getElementById('add-ingredient-btn');

  const ingredientOptions = `
    <option value="">Chọn nguyên liệu</option>
    {{#each ingredients}}
      <option value="{{id}}" data-unit="{{unit}}">{{name}} ({{unit}}){{#if isDeleted}} [đã xóa]{{/if}}</option>
    {{/each}}
  `;

  addBtn.addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'ing-row';
    row.innerHTML = `
      <select name="ingredient_id" class="ing-sel" required>${ingredientOptions}</select>
      <input type="number" step="any" min="0.01" name="quantity" placeholder="SL" class="ing-qty" required />
      <input type="text" name="unit" maxlength="30" placeholder="ĐVT" class="ing-unit" />
      <button type="button" class="remove-row-btn" title="Xóa dòng">✕</button>
    `;
    container.appendChild(row);
    row.querySelector('select').focus();
  });

  container.addEventListener('click', (e) => {
    const btn = e.target.closest('.remove-row-btn');
    if (btn) btn.closest('.ing-row').remove();
  });

  container.addEventListener('change', (e) => {
    if (!e.target.matches('select[name="ingredient_id"]')) return;
    const row = e.target.closest('.ing-row');
    const unitInput = row && row.querySelector('input[name="unit"]');
    const opt = e.target.selectedOptions && e.target.selectedOptions[0];
    if (unitInput && opt && !unitInput.value.trim()) {
      unitInput.value = opt.dataset.unit || 'g';
    }
  });
</script>
