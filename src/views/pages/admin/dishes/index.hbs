<div class="space-y-6">
  <!-- Top Bar: Search, Category Filter, and Actions -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col md:flex-row items-center justify-between gap-4">
    <form method="GET" action="/admin/dishes" class="flex flex-wrap items-center gap-3 w-full md:w-auto flex-1">
      <input
        type="text"
        name="q"
        value="{{q}}"
        placeholder="Search by dish name..."
        class="px-3.5 py-2 text-xs rounded-lg border border-slate-300 w-full sm:w-64 focus:outline-hidden focus:ring-2 focus:ring-amber-500"
      />

      <select
        name="category"
        class="px-3 py-2 text-xs rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-amber-500"
        onchange="this.form.submit()"
      >
        <option value="">All Categories</option>
        {{#each categories}}
          <option value="{{key}}" {{#if (eq ../category key)}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>

      <label class="inline-flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
        <input
          type="checkbox"
          name="deleted"
          value="1"
          {{#if showDeleted}}checked{{/if}}
          onchange="this.form.submit()"
          class="rounded border-slate-300 text-amber-600 focus:ring-amber-500"
        />
        <span>Show Deleted</span>
      </label>

      <button type="submit" class="px-3 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-xs font-semibold text-slate-700">
        Filter
      </button>

      {{#if (or q (or category showDeleted))}}
        <a href="/admin/dishes" class="text-xs text-rose-600 hover:underline">Clear</a>
      {{/if}}
    </form>

    <a href="/admin/dishes/new" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold shadow-xs transition-colors shrink-0">
      <span>+</span> New Dish
    </a>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 uppercase font-semibold border-b border-slate-200">
          <tr>
            <th class="px-6 py-3.5">Dish</th>
            <th class="px-6 py-3.5">Category</th>
            <th class="px-6 py-3.5">Price</th>
            <th class="px-6 py-3.5">Chef</th>
            <th class="px-6 py-3.5">Status</th>
            <th class="px-6 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#if dishes.length}}
            {{#each dishes}}
              <tr class="hover:bg-slate-50/60 transition-colors {{#if deletedAt}}bg-rose-50/20{{/if}}">
                <td class="px-6 py-3.5 flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg overflow-hidden bg-slate-100 border border-slate-200 shrink-0">
                    {{#if imageUrl}}
                      <img src="{{imageUrl}}" alt="{{name}}" class="w-full h-full object-cover" />
                    {{else}}
                      <div class="w-full h-full flex items-center justify-center text-sm">🍜</div>
                    {{/if}}
                  </div>
                  <div>
                    <div class="font-bold text-slate-900 flex items-center gap-2">
                      {{name}}
                      {{#if isFeatured}}
                        <span class="px-1.5 py-0.2 rounded text-[9px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800">
                          Featured
                        </span>
                      {{/if}}
                    </div>
                    <div class="text-[11px] text-slate-400 font-mono">/dishes/{{slug}}</div>
                  </div>
                </td>
                <td class="px-6 py-3.5">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-700">
                    {{categoryLabel category}}
                  </span>
                </td>
                <td class="px-6 py-3.5 font-bold text-slate-900">
                  {{formatVnd price}}
                </td>
                <td class="px-6 py-3.5 text-slate-600">
                  {{#if chef}}
                    <span class="{{#if chef.deletedAt}}text-slate-400 italic line-through{{/if}}">{{chef.name}}</span>
                  {{else}}
                    <span class="text-slate-400 italic">None</span>
                  {{/if}}
                </td>
                <td class="px-6 py-3.5">
                  {{#if deletedAt}}
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">Deleted</span>
                  {{else if isAvailable}}
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Available</span>
                  {{else}}
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600">Sold out</span>
                  {{/if}}
                </td>
                <td class="px-6 py-3.5 text-right space-x-2">
                  {{#if deletedAt}}
                    <form action="/admin/dishes/{{id}}/restore" method="POST" class="inline" onsubmit="return confirm('Restore this dish?')">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                      <button type="submit" class="text-emerald-600 hover:text-emerald-700 font-semibold">Restore</button>
                    </form>
                  {{else}}
                    <a href="/admin/dishes/{{id}}/edit" class="text-amber-600 hover:text-amber-700 font-semibold">Edit</a>
                    <span class="text-slate-300">|</span>
                    <form action="/admin/dishes/{{id}}/delete" method="POST" class="inline" onsubmit="return confirm('Move this dish to deleted list?')">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                      <button type="submit" class="text-rose-600 hover:text-rose-700 font-semibold">Delete</button>
                    </form>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                No dishes found matching your criteria.
              </td>
            </tr>
          {{/if}}
        </tbody>
      </table>
    </div>

    {{> pagination}}
  </div>
</div>
