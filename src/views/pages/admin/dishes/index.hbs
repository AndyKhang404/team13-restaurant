<section class="panel">
  <div class="panel-head">
    <h2>Danh sách món ăn</h2>
    <span class="count">{{dishes.length}} bản ghi</span>
    <div class="panel-tools">
      <form class="search" action="/admin/dishes" method="get">
        <input type="search" name="q" value="{{q}}" placeholder="Tìm theo tên món" />
        <button type="submit">Tìm</button>
      </form>
      <form action="/admin/dishes" method="get" style="display:flex;gap:10px;align-items:center">
        {{#if q}}<input type="hidden" name="q" value="{{q}}" />{{/if}}
        <select class="tools-select" name="category">
          <option value="">Tất cả danh mục</option>
          {{#each categories}}
            <option value="{{key}}" {{#if (eq ../category key)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <label class="check"><input type="checkbox" name="deleted" value="1" {{#if showDeleted}}checked{{/if}} /> Đã xóa</label>
        <button type="submit" class="btn btn-quiet btn-sm">Lọc</button>
        {{#if (or q (or category showDeleted))}}
          <a class="link-quiet" href="/admin/dishes">Xóa lọc</a>
        {{/if}}
      </form>
      <a class="btn btn-primary" href="/admin/dishes/new">Thêm món</a>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="width:70px">Hình</th>
          <th>Tên món</th>
          <th>Danh mục</th>
          <th style="width:120px">Giá</th>
          <th>Đầu bếp</th>
          <th>Trạng thái</th>
          <th style="text-align:right">Thao tác</th>
        </tr>
      </thead>
      <tbody class="fade-late">
        {{#if dishes.length}}
          {{#each dishes}}
            <tr>
              <td>
                {{#if imageUrl}}<img class="thumb" src="{{imageUrl}}" alt="{{name}}" loading="lazy" />{{else}}<span class="thumb-ph">-</span>{{/if}}
              </td>
              <td>
                <div class="cell-item">
                  <div>
                    <b>{{name}}</b>
                    <small>/dishes/{{slug}}</small>
                  </div>
                </div>
              </td>
              <td><span class="badge">{{categoryLabel category}}</span></td>
              <td class="num">{{formatVnd price}}</td>
              <td>{{#if chef}}{{chef.name}}{{else}}—{{/if}}</td>
              <td>
                {{#if deletedAt}}
                  <span class="badge danger">Đã xóa</span>
                {{else if isAvailable}}
                  <span class="badge ok">Đang bán</span>
                {{else}}
                  <span class="badge warn">Ngừng bán</span>
                {{/if}}
              </td>
              <td>
                <div class="row-actions">
                  <a class="btn btn-sm btn-quiet" href="/admin/dishes/{{id}}/edit">Sửa</a>
                  {{#if deletedAt}}
                    <form class="inline-form" action="/admin/dishes/{{id}}/restore" method="POST" onsubmit="return confirm('Khôi phục món này?')">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                      <button type="submit" class="btn btn-sm btn-quiet">Khôi phục</button>
                    </form>
                  {{else}}
                    <form class="inline-form" action="/admin/dishes/{{id}}/delete" method="POST" onsubmit="return confirm('Chuyển món này vào danh sách đã xóa?')">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                      <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        {{/if}}
      </tbody>
    </table>

    {{#unless dishes.length}}
      <div class="empty">
        <b>Không có món ăn nào</b>
        Thử đổi từ khóa bộ lọc, hoặc thêm món mới vào thực đơn.
      </div>
    {{/unless}}

    <div class="skeleton-overlay" aria-hidden="true">
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
    </div>
  </div>

  {{> pagination}}
</section>
