<div class="stats">
  <div class="stat">
    <div class="k">Tổng món ăn</div>
    <div class="v">{{stats.dishCount}}</div>
    <div class="d">đang quản lý</div>
  </div>
  <div class="stat">
    <div class="k">Đầu bếp</div>
    <div class="v">{{stats.chefCount}}</div>
    <div class="d">đang hoạt động</div>
  </div>
  <div class="stat">
    <div class="k">Nguyên liệu</div>
    <div class="v">{{stats.ingredientCount}}</div>
    <div class="d">trong kho</div>
  </div>
  <div class="stat">
    <div class="k">Người dùng</div>
    <div class="v">{{stats.userCount}}</div>
    <div class="d">đã đăng ký</div>
  </div>
</div>

<section class="panel" style="margin-bottom:26px">
  <div class="panel-head">
    <h2>Thao tác nhanh</h2>
    <div class="panel-tools">
      <a class="btn btn-primary" href="/admin/dishes/new">Thêm món</a>
      <a class="btn" href="/admin/chefs/new">Thêm đầu bếp</a>
      <a class="btn" href="/admin/ingredients/new">Thêm nguyên liệu</a>
      {{#if (can user 'user:manage')}}
        <a class="btn btn-quiet" href="/admin/users">Phân quyền</a>
      {{/if}}
    </div>
  </div>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>Món ăn cập nhật gần đây</h2>
    <span class="count">{{recentDishes.length}} bản ghi</span>
    <div class="panel-tools">
      <a class="btn btn-quiet btn-sm" href="/admin/dishes">Xem tất cả</a>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="width:70px">Hình</th>
          <th>Tên món</th>
          <th>Danh mục</th>
          <th style="width:120px">Giá</th>
          <th>Đầu bếp</th>
          <th>Trạng thái</th>
          <th style="text-align:right">Thao tác</th>
        </tr>
      </thead>
      <tbody class="fade-late">
        {{#if recentDishes.length}}
          {{#each recentDishes}}
            <tr>
              <td>
                {{#if imageUrl}}
                  <img class="thumb" src="{{imageUrl}}" alt="{{name}}" loading="lazy" />
                {{else}}
                  <span class="thumb-ph">—</span>
                {{/if}}
              </td>
              <td>
                <div class="cell-item">
                  <div>
                    <b>{{name}}</b>
                    <small>/dishes/{{slug}}</small>
                  </div>
                </div>
              </td>
              <td><span class="badge">{{categoryLabel category}}</span></td>
              <td class="num">{{formatVnd price}}</td>
              <td>{{#if chef}}{{chef.name}}{{else}}—{{/if}}</td>
              <td>
                {{#if isAvailable}}
                  <span class="badge ok">Đang bán</span>
                {{else}}
                  <span class="badge warn">Ngừng bán</span>
                {{/if}}
              </td>
              <td>
                <div class="row-actions">
                  <a class="btn btn-sm btn-quiet" href="/admin/dishes/{{id}}/edit">Sửa</a>
                </div>
              </td>
            </tr>
          {{/each}}
        {{/if}}
      </tbody>
    </table>

    {{#unless recentDishes.length}}
      <div class="empty">
        <b>Chưa có món ăn nào</b>
        Bắt đầu bằng cách thêm món đầu tiên vào thực đơn.
        <div style="margin-top:18px">
          <a class="btn btn-primary" href="/admin/dishes/new">Thêm món</a>
        </div>
      </div>
    {{/unless}}
  </div>
</section>
