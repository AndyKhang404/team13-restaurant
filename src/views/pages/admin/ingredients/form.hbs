<section class="panel form-card">
  <div class="panel-head">
    <h2>{{#if isNew}}Thêm nguyên liệu mới{{else}}Sửa nguyên liệu: {{ingredient.name}}{{/if}}</h2>
    <div class="panel-tools">
      <a class="link-quiet" href="/admin/ingredients">← Kho nguyên liệu</a>
    </div>
  </div>

  <form action="{{#if isNew}}/admin/ingredients{{else}}/admin/ingredients/{{ingredient.id}}{{/if}}" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />

    <div class="form-grid">
      <div class="field full">
        <p class="form-note">Quản lý tồn kho và giá vốn cho từng nguyên liệu.</p>
      </div>

      <div class="field">
        <label for="name">Tên nguyên liệu <span class="req">*</span></label>
        <input type="text" id="name" name="name" value="{{values.name}}" required placeholder="VD: Thịt bò tái, cà chua" />
        {{#if errors.name}}<p class="err">{{errors.name}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="unit">Đơn vị tính <span class="req">*</span></label>
        <input type="text" id="unit" name="unit" value="{{values.unit}}" required placeholder="g, kg, ml, lít, cái" />
        {{#if errors.unit}}<p class="err">{{errors.unit}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="stockQuantity">Số lượng tồn</label>
        <input type="number" step="any" id="stockQuantity" name="stockQuantity" min="0" value="{{values.stockQuantity}}" placeholder="1000" />
        {{#if errors.stockQuantity}}<p class="err">{{errors.stockQuantity}}</p>{{/if}}
      </div>

      <div class="field">
        <label for="pricePerUnit">Giá vốn / đơn vị (VNĐ)</label>
        <input type="number" step="any" id="pricePerUnit" name="pricePerUnit" min="0" value="{{values.pricePerUnit}}" placeholder="250" />
        {{#if errors.pricePerUnit}}<p class="err">{{errors.pricePerUnit}}</p>{{/if}}
      </div>

      <div class="field full">
        <label for="image">Ảnh nguyên liệu</label>
        {{#if values.imageUrl}}
          <div class="form-photo">
            <img class="img-preview" src="{{values.imageUrl}}" alt="Ảnh hiện tại" />
            <label class="check"><input type="checkbox" name="removeImage" value="on" /> Gỡ ảnh hiện tại</label>
          </div>
        {{/if}}
        <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" />
        {{#if errors.image}}<p class="err">{{errors.image}}</p>{{/if}}
        <p class="hint">JPG, PNG hoặc WebP · tối đa 2 MB.</p>
      </div>

      <div class="field full">
        <div class="check-row">
          <label class="check"><input type="checkbox" name="isAvailable" value="on" {{#if values.isAvailable}}checked{{/if}} /> Còn dùng cho công thức</label>
        </div>
      </div>
    </div>

    <div class="form-foot">
      <span class="left">Trường có dấu * là bắt buộc</span>
      <a class="btn btn-quiet" href="/admin/ingredients">Hủy</a>
      <button class="btn btn-primary" type="submit">{{#if isNew}}Tạo nguyên liệu{{else}}Lưu thay đổi{{/if}}</button>
    </div>
  </form>
</section>
