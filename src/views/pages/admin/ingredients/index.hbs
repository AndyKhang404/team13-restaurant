<section class="panel">
  <div class="panel-head">
    <h2>Danh sách nguyên liệu</h2>
    <span class="count">{{ingredients.length}} bản ghi</span>
    <div class="panel-tools">
      <form class="search" action="/admin/ingredients" method="get">
        <input type="search" name="q" value="{{q}}" placeholder="Tìm theo tên nguyên liệu" />
        <button type="submit">Tìm</button>
      </form>
      <form action="/admin/ingredients" method="get" style="display:flex;gap:10px;align-items:center">
        {{#if q}}<input type="hidden" name="q" value="{{q}}" />{{/if}}
        <label class="check"><input type="checkbox" name="deleted" value="1" {{#if showDeleted}}checked{{/if}} /> Đã xóa</label>
        <button type="submit" class="btn btn-quiet btn-sm">Lọc</button>
        {{#if (or q showDeleted)}}
          <a class="link-quiet" href="/admin/ingredients">Xóa lọc</a>
        {{/if}}
      </form>
      <a class="btn btn-primary" href="/admin/ingredients/new">Thêm nguyên liệu</a>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="width:70px">Hình</th>
          <th>Nguyên liệu</th>
          <th style="width:100px">Đơn vị</th>
          <th style="width:130px">Tồn kho</th>
          <th style="width:140px">Đơn giá</th>
          <th>Trạng thái</th>
          <th style="text-align:right">Thao tác</th>
        </tr>
      </thead>
      <tbody class="fade-late">
        {{#if ingredients.length}}
          {{#each ingredients}}
            <tr>
              <td>
                {{#if imageUrl}}
                  <img class="thumb" src="{{imageUrl}}" alt="{{name}}" />
                {{else}}
                  <span class="avatar">{{unit}}</span>
                {{/if}}
              </td>
              <td>
                <div class="cell-item">
                  <div><b>{{name}}</b></div>
                </div>
              </td>
              <td><span class="badge">{{unit}}</span></td>
              <td class="num">{{stockQuantity}}</td>
              <td class="num">{{formatVnd pricePerUnit}}</td>
              <td>
                {{#if deletedAt}}
                  <span class="badge danger">Đã xóa</span>
                {{else if isAvailable}}
                  <span class="badge ok">Sẵn có</span>
                {{else}}
                  <span class="badge warn">Hết</span>
                {{/if}}
              </td>
              <td>
                <div class="row-actions">
                  <a class="btn btn-sm btn-quiet" href="/admin/ingredients/{{id}}/edit">Sửa</a>
                  {{#if deletedAt}}
                    <form class="inline-form" action="/admin/ingredients/{{id}}/restore" method="POST" onsubmit="return confirm('Khôi phục nguyên liệu này?')">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                      <button type="submit" class="btn btn-sm btn-quiet">Khôi phục</button>
                    </form>
                  {{else}}
                    <a class="btn btn-sm btn-danger" href="/admin/ingredients/{{id}}/delete">Xóa</a>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        {{/if}}
      </tbody>
    </table>

    {{#unless ingredients.length}}
      <div class="empty">
        <b>Không có nguyên liệu nào</b>
        Thử đổi từ khóa bộ lọc, hoặc thêm nguyên liệu mới cho kho.
      </div>
    {{/unless}}

    <div class="skeleton-overlay" aria-hidden="true">
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
      <div class="sk-row"><div class="sk w80"></div><div class="sk thumb-sk"></div><div class="sk grow"></div><div class="sk w80"></div><div class="sk w80"></div></div>
    </div>
  </div>

  {{> pagination}}
</section>
