<div class="space-y-6">
  <!-- Top Bar: Search and RBAC Notice -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col md:flex-row items-center justify-between gap-4">
    <form method="GET" action="/admin/users" class="flex items-center gap-3 w-full md:w-auto flex-1">
      <input
        type="text"
        name="q"
        value="{{q}}"
        placeholder="Search users by email or name..."
        class="px-3.5 py-2 text-xs rounded-lg border border-slate-300 w-full sm:w-72 focus:outline-hidden focus:ring-2 focus:ring-amber-500"
      />

      <button type="submit" class="px-3 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-xs font-semibold text-slate-700">
        Search
      </button>

      {{#if q}}
        <a href="/admin/users" class="text-xs text-rose-600 hover:underline">Clear</a>
      {{/if}}
    </form>

    <div class="text-xs text-slate-500 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-lg flex items-center gap-1.5 shrink-0">
      <span class="text-amber-700 font-bold">ℹ️ Safeguards:</span> You cannot change your own role, and the system prevents demoting the last ADMIN.
    </div>
  </div>

  <!-- Users Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 uppercase font-semibold border-b border-slate-200">
          <tr>
            <th class="px-6 py-3.5">User</th>
            <th class="px-6 py-3.5">Registered</th>
            <th class="px-6 py-3.5">Current Role</th>
            <th class="px-6 py-3.5 text-right">Assign Role</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#if users.length}}
            {{#each users}}
              <tr class="hover:bg-slate-50/60 transition-colors">
                <td class="px-6 py-3.5">
                  <div class="font-bold text-slate-900 flex items-center gap-2">
                    {{#if displayName}}{{displayName}}{{else}}{{email}}{{/if}}
                    {{#if (eq id ../user.id)}}
                      <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-100 text-amber-800">You</span>
                    {{/if}}
                  </div>
                  {{#if displayName}}
                    <div class="text-[11px] text-slate-400 font-mono">{{email}}</div>
                  {{/if}}
                </td>
                <td class="px-6 py-3.5 text-slate-600">
                  {{formatDateTime createdAt}}
                </td>
                <td class="px-6 py-3.5">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider {{#if (eq role 'ADMIN')}}bg-purple-100 text-purple-800{{else if (eq role 'STAFF')}}bg-blue-100 text-blue-800{{else}}bg-slate-100 text-slate-700{{/if}}">
                    {{role}}
                  </span>
                </td>
                <td class="px-6 py-3.5 text-right">
                  {{#if (eq id ../user.id)}}
                    <span class="text-slate-400 italic text-[11px]">Cannot change own role</span>
                  {{else}}
                    <form action="/admin/users/{{id}}/role" method="POST" class="inline-flex items-center gap-2 justify-end" onsubmit="return confirm('Change role for {{email}}?')">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                      <select name="role" class="px-2 py-1 text-xs rounded border border-slate-300 font-medium">
                        {{#each ../roles}}
                          <option value="{{this}}" {{#if (eq ../role this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                      </select>
                      <button type="submit" class="px-2.5 py-1 text-xs rounded bg-slate-900 hover:bg-slate-800 text-white font-semibold transition-colors">
                        Save
                      </button>
                    </form>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td colspan="4" class="px-6 py-12 text-center text-slate-400">
                No users found.
              </td>
            </tr>
          {{/if}}
        </tbody>
      </table>
    </div>

    {{> pagination}}
  </div>
</div>
