<section class="panel">
  <div class="panel-head">
    <h2>Danh sách người dùng</h2>
    <span class="count">{{users.length}} bản ghi</span>
    <div class="panel-tools">
      <form class="search" action="/admin/users" method="get">
        <input type="search" name="q" value="{{q}}" placeholder="Tìm theo email hoặc tên" />
        <button type="submit">Tìm</button>
      </form>
      {{#if q}}
        <a class="link-quiet" href="/admin/users">Xóa lọc</a>
      {{/if}}
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Người dùng</th>
          <th>Ngày đăng ký</th>
          <th>Vai trò</th>
          <th style="text-align:right">Cấp vai trò</th>
        </tr>
      </thead>
      <tbody class="fade-late">
        {{#if users.length}}
          {{#each users}}
            <tr>
              <td>
                <div class="cell-item">
                  <span class="avatar">T13</span>
                  <div>
                    <b>{{#if displayName}}{{displayName}}{{else}}{{email}}{{/if}}</b>
                    {{#if displayName}}<small>{{email}}</small>{{/if}}
                  </div>
                </div>
              </td>
              <td class="mono">{{formatDateTime createdAt}}</td>
              <td>
                {{#if (eq role 'ADMIN')}}
                  <span class="badge danger">ADMIN</span>
                {{else if (eq role 'STAFF')}}
                  <span class="badge warn">STAFF</span>
                {{else}}
                  <span class="badge">CUSTOMER</span>
                {{/if}}
              </td>
              <td>
                <div class="row-actions">
                  {{#if (eq id ../user.id)}}
                    <span class="count">Không tự đổi vai trò của mình</span>
                  {{else}}
                    <form class="inline-form" action="/admin/users/{{id}}/role" method="POST" onsubmit="return confirm('Đổi vai trò cho {{email}}?')">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                      <select class="role-select" name="role">
                        {{#each ../roles}}
                          <option value="{{this}}" {{#if (eq ../role this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                      </select>
                      <button type="submit" class="btn btn-sm btn-quiet">Lưu</button>
                    </form>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        {{/if}}
      </tbody>
    </table>

    {{#unless users.length}}
      <div class="empty">
        <b>Không tìm thấy người dùng</b>
        Thử từ khóa khác.
      </div>
    {{/unless}}
  </div>

  <div class="panel-foot">
    Bạn không thể tự đổi vai trò của mình; hệ thống chặn trường hợp hạ ADMIN cuối cùng.
  </div>

  {{> pagination}}
</section>
