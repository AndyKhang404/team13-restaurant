<div class="auth-split">
  <div class="auth-aside">
    <div>
      <div class="eyebrow">Team13 Restaurant</div>
      <p class="auth-quote">Kiểm tra hộp thư của bạn.</p>
    </div>
    <div class="auth-aside-foot">
      <span>123 Nguyễn Văn Cừ, Q.5, TP.HCM</span>
      <span>1900 6868</span>
    </div>
  </div>

  <div class="auth-body">
    <h1>Kiểm tra email</h1>
    <p class="lead">{{#if message}}{{message}}{{else}}Chúng tôi đã gửi mã OTP kích hoạt tới <b>{{email}}</b>.{{/if}}</p>

    {{#if formError}}
      <div class="alert error"><b>Lỗi</b> <span>{{formError}}</span></div>
    {{/if}}

    {{#if email}}
      <a class="btn btn-solid btn-lg" href="/activate?email={{urlencode email}}">Nhập mã OTP</a>

      <form action="/activate/resend" method="POST" class="auth-alt">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <input type="hidden" name="email" value="{{email}}" />
        <button type="submit" class="btn btn-quiet">Gửi lại mã OTP</button>
      </form>
    {{/if}}

    <div class="auth-alt">
      <a href="/login">Quay lại đăng nhập</a>
    </div>
  </div>
</div>
