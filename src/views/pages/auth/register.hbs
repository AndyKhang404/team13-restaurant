<div class="auth-split">
  <div class="auth-aside">
    <div>
      <div class="eyebrow">Team13 Restaurant</div>
      <p class="auth-quote">Thành viên mới, ưu đãi theo mùa.</p>
    </div>
    <div class="auth-aside-foot">
      <span>123 Nguyễn Văn Cừ, Q.5, TP.HCM</span>
      <span>Mở cửa 09:00 — 22:00</span>
      <span>1900 6868</span>
    </div>
  </div>

  <div class="auth-body">
    <h1>Tạo tài khoản</h1>
    <p class="lead">Đăng ký thành viên để đặt bàn và nhận ưu đãi theo mùa.</p>

    {{#if formError}}
      <div class="alert error"><b>Lỗi</b> <span>{{formError}}</span></div>
    {{/if}}

    <form action="/register" method="POST">
      <input type="hidden" name="_csrf" value="{{csrfToken}}" />

      <div class="field">
        <label for="displayName">Tên hiển thị</label>
        <input type="text" id="displayName" name="displayName" value="{{values.displayName}}" placeholder="Tên của bạn" class="{{#if errors.displayName}}invalid{{/if}}" />
        {{#if errors.displayName}}<span class="err">{{errors.displayName}}</span>{{/if}}
      </div>

      <div class="field">
        <label for="email">Email <span class="req">*</span></label>
        <input type="email" id="email" name="email" value="{{values.email}}" required autocomplete="email" placeholder="ban@example.com" class="{{#if errors.email}}invalid{{/if}}" />
        {{#if errors.email}}<span class="err">{{errors.email}}</span>{{/if}}
      </div>

      <div class="field">
        <label for="password">Mật khẩu <span class="req">*</span></label>
        <div class="pw-wrap">
          <input type="password" id="password" name="password" required minlength="6" maxlength="72" autocomplete="new-password" placeholder="Tối thiểu 6 ký tự" class="{{#if errors.password}}invalid{{/if}}" />
          <button type="button" class="pw-toggle" data-pw-toggle aria-label="Hiện mật khẩu" aria-pressed="false">
            <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg>
          </button>
        </div>
        {{#if errors.password}}<span class="err">{{errors.password}}</span>{{/if}}
      </div>

      <div class="field">
        <label for="confirmPassword">Nhập lại mật khẩu <span class="req">*</span></label>
        <div class="pw-wrap">
          <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" maxlength="72" autocomplete="new-password" placeholder="Nhập lại mật khẩu" class="{{#if errors.confirmPassword}}invalid{{/if}}" />
          <button type="button" class="pw-toggle" data-pw-toggle aria-label="Hiện mật khẩu" aria-pressed="false">
            <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg>
          </button>
        </div>
        {{#if errors.confirmPassword}}<span class="err">{{errors.confirmPassword}}</span>{{/if}}
      </div>

      <div class="field">
        <div class="g-recaptcha" data-sitekey="{{captchaSiteKey}}" data-hl="vi"></div>
      </div>

      <button type="submit" class="btn btn-solid btn-lg">Tạo tài khoản</button>
    </form>

    <div class="auth-alt">
      Đã có tài khoản? <a href="/login">Đăng nhập</a>
    </div>
  </div>
</div>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{{> auth-scripts}}
