<div class="error-page">
  <div class="code">500</div>
  <h1>Lỗi máy chủ</h1>
  <p>{{#if message}}{{message}}{{else}}Đã xảy ra lỗi khi xử lý yêu cầu của bạn, thử lại sau ít phút.{{/if}}</p>
  {{#if stack}}
    <pre>{{stack}}</pre>
  {{/if}}
  <div class="actions-row" style="justify-content:center;margin-top:26px">
    <a class="btn btn-solid" href="/">Về trang chủ</a>
  </div>
</div>
