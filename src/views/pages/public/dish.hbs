<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <a href="/menu" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 transition-colors">
      ← Back to Full Menu
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
    <!-- Dish Visual Column -->
    <div class="lg:col-span-7">
      <div class="relative rounded-3xl overflow-hidden bg-slate-100 border border-slate-200 shadow-sm aspect-4/3">
        {{#if dish.imageUrl}}
          <img src="{{dish.imageUrl}}" alt="{{dish.name}}" class="w-full h-full object-cover" />
        {{else}}
          <div class="w-full h-full flex flex-col items-center justify-center text-slate-300">
            <span class="text-6xl mb-2">🍜</span>
            <span class="text-xs text-slate-400 font-medium">Delicious dish image coming soon</span>
          </div>
        {{/if}}

        <div class="absolute top-4 left-4 flex gap-2">
          <span class="px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-white/95 text-slate-800 shadow-xs backdrop-blur-xs">
            {{categoryLabel dish.category}}
          </span>
          {{#if dish.isFeatured}}
            <span class="px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-amber-500 text-white shadow-xs">
              Featured
            </span>
          {{/if}}
        </div>

        {{#unless dish.isAvailable}}
          <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-[2px] flex items-center justify-center">
            <span class="px-4 py-2 rounded-xl text-sm font-bold uppercase tracking-wider bg-rose-600 text-white shadow-lg">
              Currently Sold Out
            </span>
          </div>
        {{/unless}}
      </div>
    </div>

    <!-- Dish Details Column -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
      <div>
        <div class="flex items-center justify-between gap-4 mb-2">
          <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">{{dish.name}}</h1>
        </div>

        <div class="flex items-center gap-3 mb-6">
          <span class="text-3xl font-extrabold text-amber-600">{{formatVnd dish.price}}</span>
          {{#if dish.isAvailable}}
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
              ● Available
            </span>
          {{else}}
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
              ● Out of Stock
            </span>
          {{/if}}
          {{#if dish.prepTimeMinutes}}
            <span class="text-xs text-slate-500 font-medium flex items-center gap-1">
              ⏱️ {{dish.prepTimeMinutes}} mins prep
            </span>
          {{/if}}
        </div>

        {{#if dish.description}}
          <div class="prose prose-sm text-slate-600 leading-relaxed mb-6">
            <p>{{dish.description}}</p>
          </div>
        {{/if}}

        <!-- Ingredients Section -->
        {{#if ingredients.length}}
          <div class="pt-6 border-t border-slate-200">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Key Ingredients</h3>
            <div class="flex flex-wrap gap-2">
              {{#each ingredients}}
                <span class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium border border-slate-200/80">
                  🌿 {{this}}
                </span>
              {{/each}}
            </div>
          </div>
        {{/if}}
      </div>

      <!-- Chef Spotlight Card -->
      {{#if chef}}
        <div class="p-5 rounded-2xl bg-amber-50/60 border border-amber-200/80 flex items-start gap-4">
          <div class="w-14 h-14 rounded-full overflow-hidden bg-amber-100 border-2 border-white shadow-xs shrink-0">
            {{#if chef.avatarUrl}}
              <img src="{{chef.avatarUrl}}" alt="{{chef.name}}" class="w-full h-full object-cover" />
            {{else}}
              <div class="w-full h-full flex items-center justify-center text-xl">👨‍🍳</div>
            {{/if}}
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-[11px] font-bold uppercase tracking-wider text-amber-700">Created by Chef</div>
            <div class="text-sm font-bold text-slate-900 truncate">{{chef.name}}</div>
            {{#if chef.specialty}}
              <div class="text-xs text-slate-600 mt-0.5">Specialty: <span class="font-medium text-slate-800">{{chef.specialty}}</span></div>
            {{/if}}
            {{#if chef.bio}}
              <p class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">{{chef.bio}}</p>
            {{/if}}
          </div>
        </div>
      {{/if}}
    </div>
  </div>
</div>
