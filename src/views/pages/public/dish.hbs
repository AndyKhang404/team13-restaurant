<nav class="crumbs">
  <a href="/menu">Thực đơn</a> /
  <a href="/menu?category={{dish.category}}">{{categoryLabel dish.category}}</a> /
  {{dish.name}}
</nav>

<div class="detail">
  <div class="detail-media">
    {{#if dish.imageUrl}}
      <img src="{{dish.imageUrl}}" alt="{{dish.name}}" />
    {{else}}
      <span class="media-ph" style="aspect-ratio:4/3">{{dish.name}}</span>
    {{/if}}
  </div>

  <div>
    <div class="kicker">
      <span>{{categoryLabel dish.category}}</span>
      {{#if dish.isAvailable}}
        <span class="status">Đang bán</span>
      {{else}}
        <span class="status off">Ngừng bán</span>
      {{/if}}
      {{#if dish.isFeatured}}<span style="color:var(--accent)">Món nổi bật</span>{{/if}}
    </div>
    <h1>{{dish.name}}</h1>

    <span class="price">{{formatVnd dish.price}}</span>

    <dl class="specs">
      <div class="row"><dt>Danh mục</dt><dd>{{categoryLabel dish.category}}</dd></div>
      <div class="row"><dt>Giá bán</dt><dd>{{formatVnd dish.price}}</dd></div>
      {{#if dish.prepTimeMinutes}}
        <div class="row"><dt>Chế biến</dt><dd>khoảng {{dish.prepTimeMinutes}} phút</dd></div>
      {{/if}}
      <div class="row"><dt>Trạng thái</dt><dd>{{#if dish.isAvailable}}Đang bán{{else}}Ngừng bán{{/if}}</dd></div>
      {{#if dish.updatedAt}}
        <div class="row"><dt>Cập nhật</dt><dd>{{formatDateTime dish.updatedAt}}</dd></div>
      {{/if}}
    </dl>

    {{#if dish.description}}
      <div class="section">
        <h3>Mô tả</h3>
        <p>{{dish.description}}</p>
      </div>
    {{/if}}

    {{#if ingredients.length}}
      <div class="section">
        <h3>Nguyên liệu ({{ingredients.length}})</h3>
        <div class="tags">
          {{#each ingredients}}
            <span class="tag-item">{{this}}</span>
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{#if chef}}
      <div class="section">
        <h3>Đầu bếp phụ trách</h3>
        <div class="chef-card">
          {{#if chef.avatarUrl}}
            <img src="{{chef.avatarUrl}}" alt="{{chef.name}}" loading="lazy" />
          {{/if}}
          <div>
            <span class="role">{{#if chef.specialty}}{{chef.specialty}}{{else}}Bếp trưởng{{/if}}</span>
            <b>{{chef.name}}</b>
            {{#if chef.bio}}<p>{{chef.bio}}</p>{{/if}}
          </div>
        </div>
      </div>
    {{/if}}

    <div class="actions-row">
      <a class="btn btn-solid btn-lg" href="tel:19006868">Đặt bàn: 1900 6868</a>
      <a class="btn btn-lg" href="/menu">Quay lại thực đơn</a>
    </div>
  </div>
</div>
