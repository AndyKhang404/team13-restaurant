<section class="hero hero-split">
  <div class="hero-text">
    <div class="eyebrow">Bếp mở cửa 09:00 — 22:00 mỗi ngày</div>
    <h1>Nhà hàng Việt, nấu theo mùa</h1>
    <p>Món Việt đậm vị quê nhà cùng món Âu tinh tế, nguyên liệu tươi trong ngày, đội ngũ đầu bếp nhiều năm kinh nghiệm. Đặt bàn và thưởng thức tại Team13 Restaurant.</p>
    <div class="actions-row">
      <a class="btn btn-solid btn-lg" href="/menu">Xem thực đơn</a>
      <a class="btn btn-lg" href="tel:19006868">Đặt bàn: 1900 6868</a>
      {{#if user}}
        {{#if (can user 'admin:access')}}
          <a class="btn btn-lg" href="/admin">Quản trị</a>
        {{/if}}
      {{else}}
        <a class="btn btn-lg" href="/login">Đăng nhập</a>
      {{/if}}
    </div>
  </div>

  {{#if featured.length}}
    <a class="hero-art" href="/dishes/{{featured.[0].slug}}">
      {{#if featured.[0].imageUrl}}
        <img src="{{featured.[0].imageUrl}}" alt="{{featured.[0].name}}" />
      {{else}}
        <span class="media-ph">{{featured.[0].name}}</span>
      {{/if}}
      <span class="price-tag">
        <em>{{#if featured.[0].isFeatured}}Món nổi bật{{else}}Thực đơn{{/if}}</em>
        <b>{{formatVnd featured.[0].price}}</b>
      </span>
    </a>
  {{/if}}
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    <span class="ticker-item">Mở cửa 09:00 — 22:00 mỗi ngày</span>
    <span class="ticker-item">123 Nguyễn Văn Cừ, Q.5, TP.HCM</span>
    <span class="ticker-item">Hotline 1900 6868</span>
    <span class="ticker-item">Nguyên liệu tươi nhập mỗi sáng</span>
    <span class="ticker-item">Nhận đặt tiệc & sự kiện</span>
    <span class="ticker-item">Mở cửa 09:00 — 22:00 mỗi ngày</span>
    <span class="ticker-item">123 Nguyễn Văn Cừ, Q.5, TP.HCM</span>
    <span class="ticker-item">Hotline 1900 6868</span>
    <span class="ticker-item">Nguyên liệu tươi nhập mỗi sáng</span>
    <span class="ticker-item">Nhận đặt tiệc & sự kiện</span>
  </div>
</div>

<div class="band">
  <a class="band-item" href="/menu">
    {{#if featured.[0].imageUrl}}<img src="{{featured.[0].imageUrl}}" alt="" loading="lazy" />{{/if}}
    <span>Món nổi bật</span>
  </a>
  <a class="band-item" href="/menu">
    {{#if featured.[1].imageUrl}}<img src="{{featured.[1].imageUrl}}" alt="" loading="lazy" />{{/if}}
    <span>Nguyên liệu trong nước</span>
  </a>
  <a class="band-item" href="/menu">
    {{#if featured.[2].imageUrl}}<img src="{{featured.[2].imageUrl}}" alt="" loading="lazy" />{{/if}}
    <span>Đầu bếp nhiều năm</span>
  </a>
</div>

<section>
  <div class="eyebrow">Món nổi bật trong tuần</div>
  <div class="grid" style="margin-top:26px">
    {{#each featured}}
      <article class="dish-card">
        <a class="dish-media" href="/dishes/{{slug}}">
          {{#if imageUrl}}
            <img src="{{imageUrl}}" alt="{{name}}" loading="lazy" />
          {{else}}
            <span class="media-ph">{{name}}</span>
          {{/if}}
        </a>
        <div class="dish-body">
          <div class="dish-meta">
            <span>{{categoryLabel category}}</span>
            {{#if prepTimeMinutes}}<span>{{prepTimeMinutes}} phút</span>{{/if}}
          </div>
          <h3 class="dish-name"><a href="/dishes/{{slug}}">{{name}}</a></h3>
          <div class="dish-foot">
            <span class="price">{{formatVnd price}}</span>
            <a class="link-more" href="/dishes/{{slug}}">Chi tiết</a>
          </div>
        </div>
      </article>
    {{/each}}
  </div>
</section>

<div class="why">
  <div class="why-item">
    <span class="idx">01</span>
    <h3>Nguyên liệu tươi trong ngày</h3>
    <p>Thịt, cá, rau củ lấy từ nhà cung cấp uy tín mỗi sáng — không phẩm màu, nước dùng ninh từ hầm.</p>
  </div>
  <div class="why-item">
    <span class="idx">02</span>
    <h3>Đầu bếp nhiều năm kinh nghiệm</h3>
    <p>Đội ngũ đầu bếp Việt và Âu, hơn 10 năm đứng bếp nhà hàng, chăm chút từng đĩa món.</p>
  </div>
  <div class="why-item">
    <span class="idx">03</span>
    <h3>Phục vụ chuyên nghiệp</h3>
    <p>Không gian ấm cúng phù hợp gia đình và gặp mặt đối tác. Nhận đặt bàn qua hotline 1900 6868.</p>
  </div>
</div>

{{#unless featured.length}}
  <div class="empty">
    <b>Thực đơn đang được cập nhật</b>
    Các món mới sẽ sớm xuất hiện tại đây.
    <div class="actions-row" style="justify-content:center;margin-top:20px">
      <a class="btn btn-solid" href="/menu">Xem thực đơn</a>
    </div>
  </div>
{{/unless}}
