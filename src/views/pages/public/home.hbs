<!-- Hero Section -->
<section class="relative bg-slate-900 text-white rounded-3xl overflow-hidden mb-16 shadow-xl max-w-7xl mx-auto">
  <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-900/80 to-transparent z-10"></div>
  <img
    src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1600&q=80"
    alt="Restaurant ambiance"
    class="absolute inset-0 w-full h-full object-cover object-center filter brightness-75"
  />
  <div class="relative z-20 px-8 py-20 sm:px-12 sm:py-28 max-w-2xl">
    <span class="inline-block px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold uppercase tracking-wider mb-4 border border-amber-500/30">
      Artisanal Cuisine & Warm Hospitality
    </span>
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-6 leading-tight">
      A Symphony of Authentic Flavors
    </h1>
    <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed">
      Crafted with passion by seasoned culinary masters using farm-fresh, premium ingredients. Discover our signature specialties.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/menu" class="px-6 py-3 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-semibold text-sm shadow-lg shadow-amber-600/30 transition-all">
        Explore Menu
      </a>
      <a href="/login" class="px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm backdrop-blur-xs border border-white/20 transition-all">
        Member Portal
      </a>
    </div>
  </div>
</section>

<!-- Featured Dishes Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Chef's Highlights</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">Featured Dishes</h2>
    </div>
    <a href="/menu" class="text-sm font-semibold text-amber-600 hover:text-amber-700 flex items-center gap-1 group">
      View complete menu
      <span class="group-hover:translate-x-0.5 transition-transform">→</span>
    </a>
  </div>

  {{#if featured.length}}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {{#each featured}}
        <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md hover:border-amber-200 transition-all flex flex-col">
          <div class="relative aspect-4/3 bg-slate-100 overflow-hidden">
            {{#if imageUrl}}
              <img src="{{imageUrl}}" alt="{{name}}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            {{else}}
              <div class="w-full h-full flex items-center justify-center text-4xl bg-slate-100 text-slate-300">🍜</div>
            {{/if}}

            <div class="absolute top-3 left-3 flex gap-1.5">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-white/95 text-slate-800 shadow-xs backdrop-blur-xs">
                {{categoryLabel category}}
              </span>
            </div>

            {{#unless isAvailable}}
              <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-[2px] flex items-center justify-center">
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white shadow-md">
                  Sold out
                </span>
              </div>
            {{/unless}}
          </div>

          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-bold text-slate-900 text-base group-hover:text-amber-600 transition-colors line-clamp-1">
                {{name}}
              </h3>
              {{#if description}}
                <p class="text-xs text-slate-500 mt-1.5 line-clamp-2 leading-relaxed">{{description}}</p>
              {{/if}}
            </div>

            <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-base font-extrabold text-slate-900">{{formatVnd price}}</span>
              <a href="/dishes/{{slug}}" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-amber-50 text-amber-800 hover:bg-amber-100 transition-colors">
                Details →
              </a>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="text-center py-16 bg-white rounded-2xl border border-slate-200">
      <span class="text-4xl block mb-2">🍽️</span>
      <p class="text-slate-500 text-sm">No featured dishes available right now.</p>
      <a href="/menu" class="mt-4 inline-block text-xs font-semibold text-amber-600 hover:underline">Explore all menu dishes →</a>
    </div>
  {{/if}}
</section>
