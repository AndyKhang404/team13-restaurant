        <img src="{{featured.[0].imageUrl}}" alt="{{featured.[0].name}}" />
      {{else}}
        <span class="media-ph">{{featured.[0].name}}</span>
      {{/if}}
      <span class="price-tag">
        <em>{{#if featured.[0].isFeatured}}Món nổi bật{{else}}Thực đơn{{/if}}</em>
        <b>{{formatVnd featured.[0].price}}</b>
      </span>
    </a>
  {{/if}}
</section>

