<section class="hero" style="padding-bottom:0">
  <div class="eyebrow">Thực đơn theo mùa — giá đã bao gồm VAT</div>
  <h1>Thực đơn nhà hàng</h1>
  <p>Tìm món theo tên, lọc theo danh mục, sắp xếp theo giá hoặc tên — chọn và thưởng thức.</p>
</section>

<div class="toolbar">
  <div class="filters">
    <a href="{{allHref}}" {{#unless category}}class="active"{{/unless}}>Tất cả</a>
    {{#each categories}}
      <a href="{{href}}" {{#if active}}class="active"{{/if}}>{{label}}</a>
    {{/each}}
  </div>
  <form class="menu-tools" action="/menu" method="get" role="search">
    {{#if category}}<input type="hidden" name="category" value="{{category}}" />{{/if}}
    <input class="menu-search" type="search" name="q" value="{{q}}" placeholder="Tìm món theo tên…" aria-label="Tìm món theo tên" />
    <select class="menu-sort" name="sort" aria-label="Sắp xếp">
      <option value="" {{#unless sort}}selected{{/unless}}>Mới nhất</option>
      <option value="name-asc" {{#if (eq sort 'name-asc')}}selected{{/if}}>Tên A → Z</option>
      <option value="name-desc" {{#if (eq sort 'name-desc')}}selected{{/if}}>Tên Z → A</option>
      <option value="price-asc" {{#if (eq sort 'price-asc')}}selected{{/if}}>Giá thấp → cao</option>
      <option value="price-desc" {{#if (eq sort 'price-desc')}}selected{{/if}}>Giá cao → thấp</option>
      <option value="newest" {{#if (eq sort 'newest')}}selected{{/if}}>Mới cập nhật</option>
    </select>
    <button class="btn btn-solid" type="submit">Tìm</button>
  </form>
</div>

{{#if total}}
  <div class="menu-skel">
    <div class="eyebrow" style="margin-top:38px">
      {{#if q}}
        Kết quả cho "{{q}}" — {{total}} món · Trang {{pagination.page}} / {{pagination.totalPages}}
      {{else}}
        {{total}} món · Trang {{pagination.page}} / {{pagination.totalPages}}
      {{/if}}
    </div>
    <div class="grid" style="margin-top:22px">
      {{#each dishes}}
        {{> dish-card}}
      {{/each}}
    </div>
    {{> skeleton-overlay}}
    {{> pagination variant="public"}}
  </div>
{{else}}
  <div class="empty" style="margin-top:36px">
    <b>Không tìm thấy món nào</b>
    Thử từ khóa khác, bỏ bớt bộ lọc, hoặc xem toàn bộ thực đơn.
    <div class="actions-row" style="justify-content:center;margin-top:20px">
      <a class="btn btn-solid" href="/menu">Xem tất cả</a>
    </div>
  </div>
{{/if}}
