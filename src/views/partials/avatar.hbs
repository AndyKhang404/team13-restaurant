{{!--
  Chef avatar (Facebook-default style).
  Usage: {{> avatar url=chef.avatarUrl name=chef.name size=74 cls="thumb" }}
  - url: real photo URL (optional). When present it is always preferred.
  - name: used for alt / aria-label (optional).
  - size: box size in px (optional, default 64).
  - cls: extra CSS classes appended to the box (optional).
  Fallback (no url): minimal person glyph on a neutral light-blue disc,
  same box size and circular shape as the real photo.
--}}
{{#if url}}
  <img
    src="{{url}}"
    alt="{{#if name}}{{name}}{{else}}Ảnh đại diện{{/if}}"
    loading="lazy"
    class="avatar-img{{#if cls}} {{cls}}{{/if}}"
    style="width:{{#if size}}{{size}}{{else}}64{{/if}}px;height:{{#if size}}{{size}}{{else}}64{{/if}}px"
  />
{{else}}
  <span
    class="avatar-fb{{#if cls}} {{cls}}{{/if}}"
    role="img"
    aria-label="{{#if name}}Ảnh đại diện mặc định của {{name}}{{else}}Ảnh đại diện mặc định{{/if}}"
    style="width:{{#if size}}{{size}}{{else}}64{{/if}}px;height:{{#if size}}{{size}}{{else}}64{{/if}}px"
  ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 12.2c-2.7 0-5-2.2-5-5s2.3-5 5-5 5 2.2 5 5-2.3 5-5 5zm0 2.1c3.6 0 7.3 1.8 7.3 5.4v1.1H4.7v-1.1c0-3.6 3.7-5.4 7.3-5.4z" /></svg></span>
{{/if}}
