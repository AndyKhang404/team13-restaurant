<header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2 group">
          <span class="text-2xl">🍜</span>
          <span class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-amber-600 transition-colors">Team13 Bistro</span>
        </a>
        <nav class="hidden md:flex items-center gap-6">
          <a href="/" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Home</a>
          <a href="/menu" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Menu</a>
        </nav>
      </div>

      <div class="flex items-center gap-4">
        {{#if user}}
          <div class="flex items-center gap-3">
            {{#if (can user 'admin:access')}}
              <a href="/admin" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                Admin Panel
              </a>
            {{/if}}

            <div class="text-right hidden sm:block">
              <div class="text-xs font-semibold text-slate-800">{{#if user.displayName}}{{user.displayName}}{{else}}{{user.email}}{{/if}}</div>
              <span class="inline-block px-1.5 py-0.5 text-[10px] font-bold rounded uppercase tracking-wider {{#if (eq user.role 'ADMIN')}}bg-purple-100 text-purple-700{{else if (eq user.role 'STAFF')}}bg-blue-100 text-blue-700{{else}}bg-slate-100 text-slate-600{{/if}}">
                {{user.role}}
              </span>
            </div>

            <form action="/logout" method="POST" class="inline">
              <input type="hidden" name="_csrf" value="{{csrfToken}}" />
              <button type="submit" class="px-3 py-1.5 text-xs font-medium rounded-md border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition-colors">
                Sign out
              </button>
            </form>
          </div>
        {{else}}
          <div class="flex items-center gap-2">
            <a href="/login" class="px-3 py-1.5 text-xs font-medium rounded-md text-slate-700 hover:text-slate-900 transition-colors">
              Sign in
            </a>
            <a href="/register" class="px-3 py-1.5 text-xs font-semibold rounded-md bg-amber-600 text-white hover:bg-amber-700 shadow-xs transition-colors">
              Register
            </a>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</header>
