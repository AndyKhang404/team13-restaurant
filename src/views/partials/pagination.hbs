{{#if pagination}}
  {{#if (gt pagination.totalPages 1)}}
    {{#if (eq variant "public")}}
      <nav class="pager" aria-label="Phân trang">
        {{#if pagination.hasPrev}}
          <a href="{{{pagination.prevHref}}}" rel="prev">« Trước</a>
        {{else}}
          <span aria-disabled="true">« Trước</span>
        {{/if}}
        {{#each pagination.items}}
          {{#if (eq this.kind "page")}}
            {{#if this.current}}
              <span class="num current" aria-current="page">{{this.number}}</span>
            {{else}}
              <a class="num" href="{{{this.href}}}">{{this.number}}</a>
            {{/if}}
          {{else}}
            <span class="gap">…</span>
          {{/if}}
        {{/each}}
        <span class="compact">{{pagination.page}} / {{pagination.totalPages}}</span>
        {{#if pagination.hasNext}}
          <a href="{{{pagination.nextHref}}}" rel="next">Sau »</a>
        {{else}}
          <span aria-disabled="true">Sau »</span>
        {{/if}}
      </nav>
    {{else}}
      <div class="panel-foot">
        Hiển thị trang {{pagination.page}} / {{pagination.totalPages}} — tổng {{pagination.total}} bản ghi
        <nav class="pager" aria-label="Phân trang">
          {{#if pagination.hasPrev}}
            <a href="{{{pagination.prevHref}}}" rel="prev">« Trước</a>
          {{else}}
            <span aria-disabled="true">« Trước</span>
          {{/if}}
          {{#each pagination.items}}
            {{#if (eq this.kind "page")}}
              {{#if this.current}}
                <span class="num current" aria-current="page">{{this.number}}</span>
              {{else}}
                <a class="num" href="{{{this.href}}}">{{this.number}}</a>
              {{/if}}
            {{else}}
              <span class="gap">…</span>
            {{/if}}
          {{/each}}
          <span class="compact">{{pagination.page}} / {{pagination.totalPages}}</span>
          {{#if pagination.hasNext}}
            <a href="{{{pagination.nextHref}}}" rel="next">Sau »</a>
          {{else}}
            <span aria-disabled="true">Sau »</span>
          {{/if}}
        </nav>
      </div>
    {{/if}}
  {{/if}}
{{/if}}
