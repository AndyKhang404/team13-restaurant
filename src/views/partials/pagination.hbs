{{#if pagination}}
  {{#if (gt pagination.totalPages 1)}}
    <div class="panel-foot">
      Hiển thị trang {{pagination.page}} / {{pagination.totalPages}} — tổng {{pagination.total}} bản ghi
      <div class="pager">
        {{#if pagination.hasPrev}}
          <a href="?page={{pagination.prevPage}}{{#if pagination.baseQuery}}&{{pagination.baseQuery}}{{/if}}">Trước</a>
        {{else}}
          <span>Trước</span>
        {{/if}}
        <span class="current">{{pagination.page}}</span>
        {{#if pagination.hasNext}}
          <a href="?page={{pagination.nextPage}}{{#if pagination.baseQuery}}&{{pagination.baseQuery}}{{/if}}">Sau</a>
        {{else}}
          <span>Sau</span>
        {{/if}}
      </div>
    </div>
  {{/if}}
{{/if}}
